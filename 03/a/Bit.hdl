// File name: projects/03/a/Bit.hdl

/**
 * 1-bit register:
 * If load[t] == 1 then out[t+1] = in[t]
 *                 else out does not change (out[t+1] = out[t])
 */

CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    // 先決定要存進 DFF 的值：
    // 如果 load=1，就選 in；如果 load=0，就選舊的 out。
    Mux(a=out, b=in, sel=load, out=next);

    // DFF 是一個 1-bit memory element，會在下一個時間點輸出 next。
    DFF(in=next, out=out);
}
