// File name: projects/03/a/PC.hdl

/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    // 1. 計算遞增值 (out + 1)
    Inc16(in=oldOut, out=incOut);

    // 2. 處理 inc 訊號：如果 inc=1 則選遞增值，否則保持舊值 oldOut
    Mux16(a=oldOut, b=incOut, sel=inc, out=afterInc);

    // 3. 處理 load 訊號：如果 load=1 則覆蓋為新輸入 in，否則保留上一步結果
    Mux16(a=afterInc, b=in, sel=load, out=afterLoad);

    // 4. 處理 reset 訊號：如果 reset=1 則強制歸零，否則保留上一步結果
    // b[0..15]=false 是將 1-bit 的 false 擴展填滿 16-bit 的唯一標準寫法
    Mux16(a=afterLoad, b[0..15]=false, sel=reset, out=nextVal);

    // 5. 將最終決定的 nextVal 存入 16-bit 暫存器
    // load=true 確保不論哪個訊號觸發，每個時脈週期暫存器都會更新
    Register(in=nextVal, load=true, out=out, out=oldOut);
}
